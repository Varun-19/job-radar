{
  "name": "jobradar-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev -w @jobradar/web\" \"npm run dev -w @jobradar/api\"",
    "dev:worker": "npm run dev -w @jobradar/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:local": "sh scripts/db-local.sh start",
    "db:local:stop": "sh scripts/db-local.sh stop",
    "db:migrate": "npm run migrate -w @jobradar/db",
    "test:db": "RUN_DB_TESTS=1 node --env-file-if-exists=.env --import tsx --test tests/database.test.ts",
    "db:backup": "node --env-file-if-exists=.env --import tsx scripts/backup.mts backup",
    "db:restore": "node --env-file-if-exists=.env --import tsx scripts/backup.mts restore",
    "mcp": "npm run mcp -w @jobradar/api",
    "start": "concurrently -k -n web,api \"npm run start -w @jobradar/web\" \"npm run start -w @jobradar/api\"",
    "start:local": "node --import tsx scripts/run-local.mts",
    "install:autostart": "node --import tsx scripts/install-autostart.mts",
    "mcp:register": "node --import tsx scripts/register-mcp.mts",
    "research": "node --import tsx scripts/research.mts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
